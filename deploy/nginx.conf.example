# Ajuste server_name, root e credenciais antes de habilitar.
# Adicione HTTPS para acesso pela internet. Este exemplo mantém o teste privado.
server {
    listen 80;
    server_name jogo.exemplo.com;
    root /opt/rookland/web/dist;
    index index.html;
    client_max_body_size 5m;

    # O protótipo tem um mundo compartilhado, sem contas individuais.
    auth_basic "RookLand - teste privado";
    auth_basic_user_file /etc/nginx/rookland.htpasswd;

    location /api/ {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
